# Hermes Kanban Configuration (optional)

# Server
KANBAN_PORT=9120
KANBAN_HOST=0.0.0.0

# Auth (default: hermes/hermes)
KANBAN_AUTH_USER=hermes
KANBAN_AUTH_PASS=hermes

# Disable auth (set to 1 to disable)
# KANBAN_NO_AUTH=1

# Custom database path (optional)
# KANBAN_DB=~/.hermes/kanban.db

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_HOME_CHANNEL=your_chat_id
